extends Control
func _ready() -> void:
	var p := UIKit.panel()
	p.custom_minimum_size = Vector2(1200, 0)
	var v := UIKit.vbox(14)
	p.add_child(v)
	v.add_child(UIKit.label("Credits", 56, UIKit.INK, true, HORIZONTAL_ALIGNMENT_CENTER))
	v.add_child(UIKit.label("DISC CHAOS — a co-op sorting game made with Godot Engine (MIT).\n\nEvery game title, console, publisher, store and logo in this game is fictional and generated by code. Any resemblance to real products is coincidental.\n\nCover art, characters, rooms and music are procedurally generated. All sounds were synthesized from scratch.\n\nFonts (SIL Open Font License / Apache 2.0): Lilita One, Fredoka, Bungee, Press Start 2P, Creepster, Orbitron, Racing Sans One, Permanent Marker, Black Ops One, Monoton, Righteous.", 28, UIKit.INK, false, HORIZONTAL_ALIGNMENT_CENTER))
	v.add_child(UIKit.button("Back", UIKit.GREY, func(): Game.main.go("menu")))
	add_child(UIKit.center(p))
