; Engine configuration file.
config_version=5

[application]

config/name="Disc Chaos"
config/description="Co-op disc & case sorting chaos."
config/version="0.3"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.99, 0.84, 0.45, 1)
boot_splash/show_image=false
run/max_fps=60

[autoload]

Settings="*res://scripts/core/settings.gd"
Profile="*res://scripts/core/profile.gd"
Catalog="*res://scripts/core/catalog.gd"
Sfx="*res://scripts/audio/sfx.gd"
Covers="*res://scripts/covers/covers.gd"
Net="*res://scripts/net/net.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=886
window/size/window_width_override=1280
window/size/window_height_override=591
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.53, 0.75, 0.95, 1)
textures/default_filters/anisotropic_filtering_level=2
